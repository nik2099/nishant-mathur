{% if customer and customer.tags contains 'VIP' %}
  {% if product.selected_or_first_available_variant.metafields.custom.vip_product_handle %}
    {% assign vip_handle = product.selected_or_first_available_variant.metafields.custom.vip_product_handle %}
    {% assign vip_product = all_products[vip_handle] %}
    {% if vip_product %}
      {% assign vip_variant = vip_product.variants.first %}
      <script>
        window.VIP_VARIANT = {
          vipVariantId: {{ vip_variant.id | json }},
          vipPrice: {{ vip_variant.price | money | json }}
        };
      </script>
      <style>
        #price-{{ section.id }} { color: #d00; }
      </style>
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          // Update displayed price
          const priceEl = document.querySelector("#price-{{ section.id }}");
          if (priceEl && window.VIP_VARIANT) {
            priceEl.innerHTML = `<span class="vip-price">VIP: ${window.VIP_VARIANT.vipPrice}</span>`;
          }

          // Force add-to-cart to use VIP variant ID
          const form = document.querySelector("#product-form-{{ section.id }}");
          if (form && window.VIP_VARIANT) {
            let idInput = form.querySelector("input[name='id']");
            if (idInput) idInput.value = window.VIP_VARIANT.vipVariantId;
          }
        });
      </script>
    {% endif %}
  {% endif %}
{% endif %}
