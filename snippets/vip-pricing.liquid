{%- comment -%}
snippets/vip-pricing.liquid
Emits a small client-side object:
window.currentProductVipData = {
  isCustomerVIP: true/false,
  variantMapping: {
    "<original_variant_id>": {
      vip_variant_id: 123456789,
      vip_price_formatted: "$12.00"
    }, ...
  }
}
Requires: each original variant has metafield vip.product_handle (the handle of the VIP product).
{%- endcomment -%}

{% assign customer_is_vip = false %}
{% if customer and customer.tags contains 'VIP' %}
  {% assign customer_is_vip = true %}
{% endif %}

<script>
window.currentProductVipData = {
  isCustomerVIP: {{ customer_is_vip | json }},
  variantMapping: {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "vip_variant_id": {% assign vip_handle = variant.metafields.vip.product_handle %}
          {% if vip_handle != blank %}
            {% assign vip_prod = all_products[vip_handle] %}
            {% if vip_prod %}
              {% assign vip_match_id = "" %}
              {% assign vip_match_price_formatted = "" %}
              {% for vp in vip_prod.variants %}
                {% if vp.title == variant.title %}
                  {% assign vip_match_id = vp.id %}
                  {% assign vip_match_price_formatted = vp.price | money %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {% if vip_match_id != "" %}
                {{ vip_match_id }}
              {% else %}
                null
              {% endif %}
            {% else %}
              null
            {% endif %}
          {% else %}
            null
          {% endif %},
        "vip_price_formatted": {% if vip_match_price_formatted != "" %}{{ vip_match_price_formatted | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
};
</script>

<!-- load JS (create this asset in assets/vip-pricing.js) -->
<script src="{{ 'vip-pricing.js' | asset_url }}"></script>
