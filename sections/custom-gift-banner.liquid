<section class="custom-banner">
    {% if section.settings.banner_image %}
        <div class="banner-image">
            <img src="{{ section.settings.banner_image | image_url: width:1440 }}" alt="{{ section.settings.heading }}">
        </div>
    {% endif %}

        <div class="banner-info-section">
            <div class="banner-content">
                <h2 class="banner-heading">{{ section.settings.heading }}</h2>
                <p class="banner-description">{{ section.settings.description }}</p>
                <a href="{{ section.settings.button_link }}" class="banner-btn">
                    {{ section.settings.button_label }}
                </a>

            </div>
            <div class="info-image">
                    <img src="{{ section.settings.info_image | image_url: width:1440 }}" alt="{{ section.settings.heading }}">
            </div>
        </div>
    <div class="banner-content-btm">
        <p class="banner-btm">{{ section.settings.description-btm }}</p>
     </div>
</section>
{% schema %}
{
    "name": "Custom Banner Section",
    "settings": [

        {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Banner Image"
        },

        {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "The Gift Guide"
        },

        {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
        },

        {
        "type": "url",
        "id": "button_link",
        "label": "Button Link",
        "default":"/collections/all"
        },

        {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "Shop Now"
        },
        {
        "type": "image_picker",
        "id": "info_image",
        "label": "Banner Image"
        },
         {
        "type": "textarea",
        "id": "description-btm",
        "label": "Bottom Heading",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
        }
    ],
    "presets": [
        {
            "name": "Custom Banner",
            "category": "Custom Sections"
        }
    ]
}
{% endschema %}

<style>
.custom-banner {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.custom-banner .banner-image img {
  width: 100%;
  height: auto;
  display: block;
}

.custom-banner .banner-content {
  
  bottom: 40px;
  left: 40px;
  background: rgba(255,255,255,0.9);
  padding: 20px 30px;
  max-width: 500px;
  border-radius: 6px;
}

.banner-heading {
  font-family: Jost;
font-weight: 500;
font-style: Medium;
font-size: 70px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0px;
vertical-align: middle;

}

.banner-description {
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 20px;
  color: #333;
}

.banner-btn {
  display: inline-block;
  background: #000;
  color: #fff;
  padding: 12px 24px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
}

.banner-btn:hover {
  background: #333;
}
.info-image img {
    width: 890px;
    object-fit: cover;
}
.banner-info-section {
    display: inline-flex;
}
  
/* Responsive */
@media (max-width: 768px) {
  .custom-banner .banner-content {
    position: relative;
    bottom: auto;
    left: auto;
    margin: 20px;
    background: transparent;
    padding: 0;
  }
}
</style>