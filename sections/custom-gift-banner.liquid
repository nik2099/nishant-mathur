<section class="custom-banner">
    {% if section.settings.banner_image %}
        <div class="banner-image">
            <img src="{{ section.settings.banner_image | image_url: width:1440 }}" alt="{{ section.settings.heading }}">
        </div>
    {% endif %}

         <div class="gift-guide-container">
    
                <!-- Left Content -->
                <div class="gift-guide-left">
                <h2>{{ section.settings.collection_heading }}</h2>
                <p>{{ section.settings.collection_description }}</p>
                {% if section.settings.collection_button_link != blank %}
                    <a href="{{ section.settings.collection_button_link }}" class="gift-guide-btn">
                    {{ section.settings.collection_button_text }}
                    </a>
                {% endif %}
                </div>

                <!-- Right Image -->
                <div class="gift-guide-right">
                {% if section.settings.right_image %}
                    <img src="{{ section.settings.right_image | image_url: width: 900 }}" alt="Gift Guide Image">
                {% endif %}
                </div>
            </div>

            <!-- Bottom Small Heading -->
            <div class="gift-guide-bottom">
                <p>{{ section.settings.bottom_heading }}</p>
            </div>
</section>
{% schema %}
{
    "name": "Custom Banner Section",
    "settings": [

        {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Banner Image"
        },

       {
      "type": "text",
      "id": "collection_heading",
      "label": "Collection Heading",
      "default": "The Gift Guide"
        },

        {
        "type": "textarea",
        "id": "collection_description",
        "label": "Collection Description",
        "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
        },

        {
        "type": "url",
        "id": "collection_button_link",
        "label": "Button Link"
        },

        {
        "type": "text",
        "id": "collection_button_text",
        "label": "Button Text",
        "default": "Shop Now"
        },

        {
        "type": "image_picker",
        "id": "right_image",
        "label": "Right Side Image"
        },
        
        {
        "type": "text",
        "id": "bottom_heading",
        "label": "Bottom Small Heading",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
        }
    ],
    "presets": [
        {
            "name": "Custom Banner",
            "category": "Custom Sections"
        }
    ]
}
{% endschema %}

<style>
.custom-banner {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.custom-banner .banner-image img {
  width: 100%;
  height: auto;
  display: block;
}

.custom-banner .banner-content {
  
  bottom: 40px;
  left: 40px;
  background: rgba(255,255,255,0.9);
  padding: 20px 30px;
  max-width: 500px;
  border-radius: 6px;
}

.banner-heading {


font-weight: 600;
font-style: Medium;
font-size: 60px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0px;
vertical-align: middle;


}

.banner-description {
  
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 20px;
  color: #333;
}

.banner-btn {
  
  display: inline-block;
  background: #000;
  color: #fff;
  padding: 12px 24px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
}

.banner-btn:hover {
  background: #333;
}
.info-image img {
    width: 890px;
    object-fit: cover;
}
.banner-info-section {
    display: inline-flex;
}
  
/* Responsive */
@media (max-width: 768px) {
  .custom-banner .banner-content {
    position: relative;
    bottom: auto;
    left: auto;
    margin: 20px;
    background: transparent;
    padding: 0;
  }
}
</style>