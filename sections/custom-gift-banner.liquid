<section class="custom-banner">
    {% if section.settings.banner_image %}
        <div class="banner-image">
            <img src="{{ section.settings.banner_image | image_url: width:1440 }}" alt="{{ section.settings.heading }}">
        </div>
    {% endif %}

         <div class="gift-guide-container">
    
                <!-- Left Content -->
                <div class="gift-guide-left">
                <h2>{{ section.settings.collection_heading }}</h2>
                <p>{{ section.settings.collection_description }}</p>
                {% if section.settings.collection_button_link != blank %}
                    <a href="{{ section.settings.collection_button_link }}" class="gift-guide-btn">
                    {{ section.settings.collection_button_text }}
                    </a>
                {% endif %}
                </div>

                <!-- Right Image -->
                <div class="gift-guide-right">
                {% if section.settings.right_image %}
                    <img src="{{ section.settings.right_image | image_url: width: 900 }}" alt="Gift Guide Image">
                {% endif %}
                </div>
            </div>

            <!-- Bottom Small Heading -->
            <div class="gift-guide-bottom">
                <p>{{ section.settings.bottom_heading }}</p>
            </div>
</section>
{% schema %}
{
    "name": "Custom Banner Section",
    "settings": [

        {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Banner Image"
        },

       {
      "type": "text",
      "id": "collection_heading",
      "label": "Collection Heading",
      "default": "The Gift Guide"
        },

        {
        "type": "textarea",
        "id": "collection_description",
        "label": "Collection Description",
        "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
        },

        {
        "type": "url",
        "id": "collection_button_link",
        "label": "Button Link"
        },

        {
        "type": "text",
        "id": "collection_button_text",
        "label": "Button Text",
        "default": "Shop Now"
        },

        {
        "type": "image_picker",
        "id": "right_image",
        "label": "Right Side Image"
        },

        {
        "type": "text",
        "id": "bottom_heading",
        "label": "Bottom Small Heading",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
        }
    ],
    "presets": [
        {
            "name": "Custom Banner",
            "category": "Custom Sections"
        }
    ]
}
{% endschema %}

<style>
    .custom-banner {
  font-family: 'Jost', sans-serif;
}
.custom-banner {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.custom-banner .banner-image img {
  width: 100%;
  height: auto;
  display: block;
}

.gift-guide-section {
  width: 100%;
  margin: 40px auto;
  padding: 20px 0;
}

.gift-guide-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-left: 50px;
 
}

.gift-guide-left {
  flex: 0 0 40%;
}

.gift-guide-left h2 {
  font-size: 70px;
  font-weight: bold;
  margin-bottom: 15px;
}

.gift-guide-left p {
  margin-bottom: 20px;
  color: #555;
  line-height: 1.6;
}

.gift-guide-btn {
  display: inline-block;
  background: #000;
  color: #fff;
  padding: 12px 24px;
  text-decoration: none;
  font-weight: bold;
}

.gift-guide-btn:hover {
  background: #333;
}

.gift-guide-right {
  flex: 0 0 60%;
  text-align: right;
}

.gift-guide-right img {
  max-width: 100%;
  height: auto;
}

.gift-guide-bottom {
  text-align: center;
  margin-top: 30px;
}
.gift-guide-bottom {
    background-color: #F5F5F5;
}

.gift-guide-bottom p {
  font-size: 16px;
  color: #333;
  letter-spacing: 1px;
}

/* Responsive */
@media(max-width: 768px) {
  .gift-guide-container {
    flex-direction: column;
    text-align: center;
    margin-left:0px;
  }
  .gift-guide-left, .gift-guide-right {
    flex: 0 0 100%;
    text-align: center;
  }
  .gift-guide-right img {
    margin-top: 20px;
  }
}
  

}
</style>