<header class="site-header">
  <div class="header-inner">

    <!-- Mobile Menu Button -->
    <button class="menu-toggle" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Logo Section -->
    <div class="site-logo">
      {% if settings.logo %}
        <a href="{{ shop.url }}">
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" class="logo-img">
        </a>
      {% else %}
        <a href="{{ shop.url }}" class="logo-text">{{ settings.logo_text | default: shop.name }}</a>
      {% endif %}
    </div>

    <!-- CTA Section (desktop only) -->
    <div class="header-cta desktop-cta">
      <span class="cta-text">Find the ideal gift for your loved ones.</span>
      <a href="/collections/all" class="cta-btn">CHOOSE GIFT →</a>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu">
    <div class="header-cta mobile-cta">
      <span class="cta-text">Find the ideal gift for your loved ones.</span>
      <a href="/collections/all" class="cta-btn">CHOOSE GIFT    →</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Logo",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    }
  ],
  "presets": [
    {
      "name": "Custom Header",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<style>
/* Header Styles */
.site-header {
  background: #f9f9f9;
  border-bottom: 1px solid #eee;
  padding: 10px 20px;
  position: relative;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
}

/* Logo */
.site-logo {
  flex-shrink: 0;
}
.logo-img {
  max-height: 40px;
}
.logo-text {
  font-size: 20px;
  font-weight: 600;
  text-decoration: none;
  color: #000;
}

/* CTA Section */
.header-cta {
  align-items: center;
  gap: 15px;
  display: contents;
    width: 80%;
}
.cta-text {
  font-size: 14px;
  color: #333;
}
.cta-btn {
  background: #ffeb3b;
  color: #000;
  font-weight: bold;
  padding: 5px 22px;
  border-radius: 4px;
  text-decoration: none;
  align-items: center;
  gap: 5px;
  transition: background 0.3s ease;
}
.cta-btn:hover {
  background: #fdd835;
}

/* Mobile Menu Toggle */
.menu-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  position: absolute;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 9999;
}

.menu-toggle span {
  width: 24px;
  height: 2px;
  background: #000;
  border-radius: 2px;
  transition: all 0.3s ease;
}

/* Hamburger to X transition */
.menu-toggle.active span:nth-child(1) {
  transform: rotate(45deg) translate(5px, 5px);
}
.menu-toggle.active span:nth-child(2) {
  opacity: 0;
}
.menu-toggle.active span:nth-child(3) {
  transform: rotate(-45deg) translate(5px, -5px);
}

/* Mobile Menu */
.mobile-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid #eee;
  padding: 20px;
  text-align: center;
  opacity: 0;
  transform: translateY(-10px);
  transition: all 0.3s ease;
}
.mobile-menu.active {
  display: block;
  opacity: 1;
  transform: translateY(0);
}

/* Responsive */
@media (max-width: 768px) {
  .desktop-cta {
    display: none;
  }

  /* Center the logo */
  .site-logo {
    margin: 0 auto;
    text-align: center;
  }

  .menu-toggle {
    display: flex;
  }
  .cta-btn {
  background: #ffeb3b;
  color: #000;
  font-weight: bold;
  padding: 5px 22px;
  border-radius: 4px;
  text-decoration: none;
  display: inline-block;
  width: 55%;
  align-items: center;
  gap: 5px;
  transition: background 0.3s ease;
}
.header-cta {
  align-items: center;
  gap: 15px;
  
}
}

@media (min-width: 769px) {
  .mobile-menu {
    display: none !important;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){
  const toggle = document.querySelector(".menu-toggle");
  const mobileMenu = document.querySelector(".mobile-menu");

  toggle.addEventListener("click", function(){
    toggle.classList.toggle("active");
    mobileMenu.classList.toggle("active");
  });
});
</script>