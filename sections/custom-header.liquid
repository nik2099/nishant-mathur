<header class="site-header">
  <div class="header-inner">

    <!-- Mobile Menu Button -->

    <button class="menu-toggle" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Logo Section -->

    <div class="site-logo">
      {% if settings.logo %}
        <a href="{{ shop.url }}">
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" class="logo-img">
        </a>
      {% else %}
        <a href="{{ shop.url }}" class="logo-text">{{ settings.logo_text | default: shop.name }}</a>
      {% endif %}
    </div>

    <!-- CTA Section -->

    <div class="header-cta">
      <span class="cta-text">Find the ideal gift for your loved ones.</span>
      <a href="/collections/all" class="cta-btn">CHOOSE GIFT →</a>
    </div>
  </div>
</header>

{% schema %}

{
  "name": "Logo",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    }
  ],
  "presets": [
    {
      "name": "Custom Header",
      "category": "Custom Sections"
    }
  ]
}

{% endschema %}

<style>

    /* Header Styles */
.site-header {
  background: #f9f9f9;
  border-bottom: 1px solid #eee;
  padding: 10px 20px;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
}

/* Logo */
.site-logo {
  flex-shrink: 0;
}
.logo-img {
  max-height: 40px;
}
.logo-text {
  font-size: 20px;
  font-weight: 600;
  text-decoration: none;
  color: #000;
}

/* CTA Section */
.header-cta {
  display: flex;
  align-items: center;
  gap: 15px;
}
.cta-text {
  font-size: 14px;
  color: #333;
}
.cta-btn {
  background: #ffeb3b;
  color: #000;
  font-weight: bold;
  padding: 10px 20px;
  border-radius: 4px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: background 0.3s ease;
}
.cta-btn:hover {
  background: #fdd835;
}

/* Mobile Menu Toggle */
.menu-toggle {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  cursor: pointer;
}
.menu-toggle span {
  width: 20px;
  height: 2px;
  background: #000;
  display: block;
}

/* Responsive */
@media (max-width: 768px) {
  .header-inner {
    flex-direction: row;
    justify-content: space-between;
  }

  .header-cta {
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .menu-toggle {
    display: flex;
  }
}

</style>