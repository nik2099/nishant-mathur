<section class="custom-product-grid">
  <div class="page-width">
    <!-- Section Heading -->
    <h2 class="grid-heading">{{ section.settings.section_heading }}</h2>

    <div class="grid-container">
      {% assign collection_handle = section.settings.collection %}
      {% if collections[collection_handle] != blank %}
        {% for product in collections[collection_handle].products limit:9 %}
          <div class="grid-item">
            <div class="product-image-wrapper">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="product-image">
              <!-- Plus Icon -->
              <button class="plus-icon" data-product-id="{{ product.id }}">+</button>
            </div>
            <h3 class="product-title">{{ product.title }}</h3>
          </div>
        {% endfor %}
      {% else %}
        <p>No collection selected or no products found.</p>
      {% endif %}
    </div>
  </div>

  <!-- Popup -->
  <div class="product-popup" id="productPopup">
    <div class="popup-content">
      <span class="popup-close">&times;</span>
      <div id="popup-body">
        <!-- Dynamic content will load here -->
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Tisso vision in the wild"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid "
    }
  ]
}
{% endschema %}

<style>
.custom-product-grid {
  padding: 50px 0;
}

.page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

.grid-heading {
  text-align: left;
  font-size: 2rem;
  margin-bottom: 30px;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.grid-item {
  position: relative;
  text-align: center;
}

.product-image-wrapper {
  position: relative;
  overflow: hidden;
}

.product-image {
  width: 100%;
  display: block;
}

.plus-icon {
  position: absolute;
  bottom: 15px;
  right: 15px;
  background: #fff;
  border: 2px solid #000;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-icon:hover {
  background: #000;
  color: #fff;
}

.product-title {
  margin-top: 10px;
  font-size: 1rem;
  font-weight: 500;
}

/* Popup styling */
.product-popup {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background: rgba(0,0,0,0.6);
}

.popup-content {
  background: #fff;
  margin: 5% auto;
  padding: 20px;
  max-width: 600px;
  position: relative;
  border-radius: 8px;
}

.popup-close {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 24px;
  cursor: pointer;
}

/* Responsive */
@media(max-width: 991px) {
  .grid-container {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media(max-width: 600px) {
  .grid-container {
    grid-template-columns: 1fr;
  }
  .grid-heading {
    text-align: center;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  var plusButtons = document.querySelectorAll(".plus-icon");
  var popup = document.getElementById("productPopup");
  var popupClose = document.getElementById("popupClose");
  var popupBody = document.getElementById("popupBody");

  // Handle click on plus icons
  plusButtons.forEach(function(button) {
    button.addEventListener("click", function() {
      var productId = this.getAttribute("data-product-id");
      // Placeholder content (you can extend later)
      popupBody.innerHTML = "<p>Popup content for product ID: " + productId + "</p>";
      popup.style.display = "block";
    });
  });

  // Close button
  popupClose.addEventListener("click", function() {
    popup.style.display = "none";
  });

  // Close when clicking outside popup
  window.addEventListener("click", function(event) {
    if (event.target === popup) {
      popup.style.display = "none";
    }
  });
});
</script>