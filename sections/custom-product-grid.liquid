<section class="custom-product-grid">
  <div class="page-width">
    <!-- Section Heading -->
    <h2 class="grid-heading">{{ section.settings.section_heading }}</h2>

    <div class="grid-container">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        {% if product %}
          <div class="grid-item">
            <div class="product-image-wrapper">
              <img 
                src="{{ product.featured_image | image_url: width: 600 }}" 
                alt="{{ product.title }}"
                class="product-image"
              >
              <!-- Plus Icon positioned with custom top/left -->
             <button 
                class="plus-icon" 
                style="top: {{ block.settings.hotspot_top }}%; left: {{ block.settings.hotspot_left }}%;" 
                data-product='{
                    "id": "{{ product.id }}",
                    "title": "{{ product.title | escape }}",
                    "price": "{{ product.price | money }}",
                    "description": "{{ product.description | strip_html | escape }}",
                    "image": "{{ product.featured_image | image_url: width: 400 }}",
                    "url": "{{ product.url }}",
                    "options": {{ product.options_with_values | json }},
                    "variants": {{ product.variants | json }}
                }'>+</button>
            </div>
           
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Popup -->
  <div class="product-popup" id="productPopup">
    <div class="popup-content">
      <span class="popup-close" id="popupClose">&times;</span>
      <div id="popupBody"></div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Custom Product Grid ",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "range",
          "id": "hotspot_top",
          "label": "Hotspot Top (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_left",
          "label": "Hotspot Left (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
       "category": "Custom Sections",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}

<style>
.custom-product-grid {
  font-family: 'Jost', sans-serif;
}

.page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

.grid-heading {
  text-align: left;
  font-size: 36px;
  margin-bottom: 30px;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 25px;
}

.product-image-wrapper {
  position: relative;
  overflow: hidden;
}

.product-image {
  width: 100%;
  display: block;
}

.plus-icon {
  position: absolute;
  transform: translate(-50%, -50%);
  background: #fff;
  border: 1px solid #fff;
  border-radius: 50%;
  width: 20px;
  height: 20px;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.plus-icon:hover {
  background: #fff;
  color: #000000;
}

.product-title {
  text-align: center;
  font-size: 1rem;
  margin-top: 10px;
}

/* Popup styling */
.product-popup {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background: rgba(0,0,0,0.6);
}

.popup-content {
  background: #fff;
  margin: 5% auto;
  padding: 20px;
  max-width: 311px;
  position: relative;
  border-radius: 8px;
}

.popup-close {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 24px;
  cursor: pointer;
}

.popup-product {
  display: flex;
  gap: 15px;
  
}

.popup-product img {
    max-width: 120px;
    border-radius: 4px;
    height: 140px;
    object-fit: cover;
}

.popup-details {
  flex: 1;
}

.popup-details h3 {
  font-size: 1.2rem;
  margin: 0 0 8px;
}

.popup-details .price {
  font-weight: bold;
  margin-bottom: 10px;
}

.popup-details .desc {
  font-size: 0.9rem;
  color: #444;
  margin-bottom: 15px;
}

/* Options */
.popup-option {
 
}

.popup-option label {
  font-size: 14px;
  font-weight: 400;
  display: block;
  margin-bottom: 6px;
}

.color-options {
  display: flex;
  gap: 10px;
}
.color-options button {
  padding: 8px 15px;
  border: 1px solid #000;
  cursor: pointer;
  background: #fff;
  width: 100%;
  text-align: left;
  position: relative;
}

.color-options button::before {
  content: "";
  display: block;
  width: 6px;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  background: var(--color-value, #000); /* fallback black */
}

.color-options button.active {
  background: #000;
  color: #fff;
}

.size-select {
  width: 100%;
  padding: 10px;
  border: 1px solid #aaa;
}

/* Add to Cart */
.add-to-cart-btn {
  margin-top: 20px;
  width: 100%;
  background: #000;
  color: #fff;
  padding: 14px;
  font-size: 1rem;
  cursor: pointer;
  border: none;
}

.add-to-cart-btn:hover {
  background: #333;
}

/* Responsive */
@media(max-width: 600px) {
  .popup-product {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .grid-heading {
    font-size: 24px;
    
}
}
</style>
<script>
document.addEventListener("DOMContentLoaded", function() {
  var plusButtons = document.querySelectorAll(".plus-icon");
  var popup = document.getElementById("productPopup");
  var popupClose = document.getElementById("popupClose");
  var popupBody = document.getElementById("popupBody");

  plusButtons.forEach(function(button) {
    button.addEventListener("click", function() {
      var productData = JSON.parse(this.getAttribute("data-product"));
      var options = productData.options || [];
      var variants = productData.variants || [];

      // find color & size option
      var colorOption = options.find(function(o){ return o.name.toLowerCase() === "color"; });
      var sizeOption = options.find(function(o){ return o.name.toLowerCase() === "size"; });

      // Build color buttons
      var colorButtonsHTML = "";
      if (colorOption) {
        colorOption.values.forEach(function(value) {
          colorButtonsHTML += `
            <button type="button" class="color-btn" data-color="${value}" style="--color-value:${value.toLowerCase()};">
              ${value}
            </button>
          `;
        });
      }

      // Build size dropdown
      var sizeOptionsHTML = "";
      if (sizeOption) {
        sizeOptionsHTML += `<option>Choose your size</option>`;
        sizeOption.values.forEach(function(value) {
          sizeOptionsHTML += `<option value="${value}">${value}</option>`;
        });
      }

      // Final Popup HTML
      var popupHTML = `
        <div class="popup-product">
          <img src="${productData.image}" alt="${productData.title}">
          <div class="popup-details">
            <h3>${productData.title}</h3>
            <div class="price">${productData.price}</div>
            <div class="desc">${productData.description}</div>
          </div>
        </div>
        
        ${colorOption ? `
        <div class="popup-option">
          <label>Color</label>
          <div class="color-options">${colorButtonsHTML}</div>
        </div>` : ""}

        ${sizeOption ? `
        <div class="popup-option">
          <label>Size</label>
          <select class="size-select">${sizeOptionsHTML}</select>
        </div>` : ""}

        <button class="add-to-cart-btn">ADD TO CART →</button>
      `;

      popupBody.innerHTML = popupHTML;
      popup.style.display = "block";

      // Handle color selection
      var colorButtons = popupBody.querySelectorAll(".color-options .color-btn");
      colorButtons.forEach(function(btn) {
        btn.addEventListener("click", function() {
          colorButtons.forEach(function(b){ b.classList.remove("active"); });
          this.classList.add("active");
        });
      });
    });
  });

  popupClose.addEventListener("click", function() {
    popup.style.display = "none";
  });

  window.addEventListener("click", function(event) {
    if (event.target === popup) {
      popup.style.display = "none";
    }
  });
});

// Add to Cart
document.querySelector(".add-to-cart-btn").addEventListener("click", function(){
  let selectedColor = document.querySelector(".variant-button.active")?.dataset.value;
  let selectedSize = document.getElementById("sizeSelect")?.value;

  // Try to match correct variant by comparing options in order
  let variant = product.variants.find(v => {
    let match = true;
    if (selectedColor && product.options.includes("Color")) {
      let colorIndex = product.options.indexOf("Color");
      match = match && (v.options[colorIndex] === selectedColor);
    }
    if (selectedSize && product.options.includes("Size")) {
      let sizeIndex = product.options.indexOf("Size");
      match = match && (v.options[sizeIndex] === selectedSize);
    }
    return match;
  });

  if(variant) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variant.id, quantity: 1 })
    })
    .then(res => res.json())
    .then(data => {
      console.log("Added to cart:", data);
      alert('Added to cart!');
      popup.style.display = "none";
    })
    .catch(err => {
      console.error("Cart error:", err);
      alert("Something went wrong adding to cart.");
    });
  } else {
    alert(" Please select required options before adding to cart.");
  }
});
</script>