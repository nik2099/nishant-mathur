<section class="custom-product-grid">
  <div class="page-width">
    <!-- Section Heading -->
    <h2 class="grid-heading">{{ section.settings.section_heading }}</h2>

    <div class="grid-container">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        {% if product %}
          <div class="grid-item">
            <div class="product-image-wrapper">
              <img 
                src="{{ product.featured_image | image_url: width: 600 }}" 
                alt="{{ product.title }}"
                class="product-image"
              >
              <!-- Plus Icon positioned with custom top/left -->
              <button 
                class="plus-icon" 
                style="top: {{ block.settings.hotspot_top }}%; left: {{ block.settings.hotspot_left }}%;" 
                data-product='{
                  "id": "{{ product.id }}",
                  "title": "{{ product.title | escape }}",
                  "price": "{{ product.price | money }}",
                  "description": "{{ product.description | strip_html | escape }}",
                  "image": "{{ product.featured_image | image_url: width: 400 }}",
                  "url": "{{ product.url }}"
                }'>+</button>
            </div>
            <h3 class="product-title">{{ product.title }}</h3>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Popup -->
  <div class="product-popup" id="productPopup">
    <div class="popup-content">
      <span class="popup-close" id="popupClose">&times;</span>
      <div id="popupBody"></div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Custom Product Grid ",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "range",
          "id": "hotspot_top",
          "label": "Hotspot Top (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_left",
          "label": "Hotspot Left (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
       "category": "Custom Sections",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}

<style>
.custom-product-grid {
  font-family: 'Jost', sans-serif;
}

.page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

.grid-heading {
  text-align: left;
  font-size: 2rem;
  margin-bottom: 30px;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 25px;
}

.product-image-wrapper {
  position: relative;
  overflow: hidden;
}

.product-image {
  width: 100%;
  display: block;
}

.plus-icon {
  position: absolute;
  transform: translate(-50%, -50%);
  background: #fff;
  border: 2px solid #000;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.plus-icon:hover {
  background: #000;
  color: #fff;
}

.product-title {
  text-align: center;
  font-size: 1rem;
  margin-top: 10px;
}

/* Popup Styles */
.product-popup {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  background: rgba(0,0,0,0.6);
}

.popup-content {
  background: #fff;
  margin: 5% auto;
  padding: 20px;
  max-width: 500px;
  position: relative;
  border-radius: 12px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.3);
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}

.popup-close {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 28px;
  cursor: pointer;
  color: #333;
}

.popup-close:hover {
  color: #000;
}

.popup-product {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.popup-product img {
  max-width: 200px;
  margin-bottom: 15px;
}

.popup-details h3 {
  font-size: 1.5rem;
  margin-bottom: 10px;
}

.popup-details .price {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 10px;
}

.popup-details .desc {
  font-size: 0.95rem;
  color: #555;
  margin-bottom: 20px;
}

.add-to-cart-btn {
  background: #000;
  color: #fff;
  border: none;
  padding: 12px 25px;
  border-radius: 6px;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.2s ease;
}

.add-to-cart-btn:hover {
  background: #444;
}

/* Mobile */
@media (max-width: 768px) {
  .grid-heading { text-align: center; }
  .popup-content { width: 90%; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  var plusButtons = document.querySelectorAll(".plus-icon");
  var popup = document.getElementById("productPopup");
  var popupClose = document.getElementById("popupClose");
  var popupBody = document.getElementById("popupBody");

  plusButtons.forEach(function(button) {
    button.addEventListener("click", function() {
      var productData = JSON.parse(this.getAttribute("data-product"));
      var popupHTML = `
        <div class="popup-product">
          <img src="${productData.image}" alt="${productData.title}">
          <div class="popup-details">
            <h3>${productData.title}</h3>
            <div class="price">${productData.price}</div>
            <div class="desc">${productData.description}</div>
          </div>
        </div>
        <a href="${productData.url}" class="add-to-cart-btn">VIEW PRODUCT →</a>
      `;
      popupBody.innerHTML = popupHTML;
      popup.style.display = "block";
    });
  });

  popupClose.addEventListener("click", function() {
    popup.style.display = "none";
  });
  window.addEventListener("click", function(e) {
    if (e.target === popup) popup.style.display = "none";
  });
});
</script>

