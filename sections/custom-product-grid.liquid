<section class="custom-product-grid">
  <div class="page-width">
    <!-- Section Heading -->
    <h2 class="grid-heading">{{ section.settings.section_heading }}</h2>

    <div class="grid-container">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        {% if product %}
          <div class="grid-item">
            <div class="product-image-wrapper">
              <img 
                src="{{ product.featured_image | image_url: width: 600 }}" 
                alt="{{ product.title }}"
                class="product-image"
              >
              <!-- Plus Icon positioned with custom top/left -->
              <button 
                class="plus-icon" 
                style="top: {{ block.settings.hotspot_top }}%; left: {{ block.settings.hotspot_left }}%;" 
                data-product='{
                  "id": "{{ product.id }}",
                  "title": "{{ product.title | escape }}",
                  "price": "{{ product.price | money }}",
                  "description": "{{ product.description | strip_html | escape }}",
                  "image": "{{ product.featured_image | image_url: width: 400 }}",
                  "url": "{{ product.url }}"
                }'>+</button>
            </div>
           
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Popup -->
  <div class="product-popup" id="productPopup">
    <div class="popup-content">
      <span class="popup-close" id="popupClose">&times;</span>
      <div id="popupBody"></div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Custom Product Grid ",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "range",
          "id": "hotspot_top",
          "label": "Hotspot Top (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_left",
          "label": "Hotspot Left (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
       "category": "Custom Sections",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}

<style>
.custom-product-grid {
  font-family: 'Jost', sans-serif;
}

.page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

.grid-heading {
  text-align: left;
  font-size: 2rem;
  margin-bottom: 30px;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 25px;
}

.product-image-wrapper {
  position: relative;
  overflow: hidden;
}

.product-image {
  width: 100%;
  display: block;
}

.plus-icon {
  position: absolute;
  transform: translate(-50%, -50%);
  background: #fff;
  border: 1px solid #fff;
  border-radius: 50%;
  width: 20px;
  height: 20px;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.plus-icon:hover {
  background: #fff;
  color: #000000;
}

.product-title {
  text-align: center;
  font-size: 1rem;
  margin-top: 10px;
}

/* Popup styling */
.product-popup {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background: rgba(0,0,0,0.6);
}

.popup-content {
  background: #fff;
  margin: 5% auto;
  padding: 20px;
  max-width: 311px;
  position: relative;
  border-radius: 8px;
}

.popup-close {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 24px;
  cursor: pointer;
}

.popup-product {
  display: flex;
  gap: 15px;
  
}

.popup-product img {
    max-width: 120px;
    border-radius: 4px;
    height: 140px;
    object-fit: cover;
}

.popup-details {
  flex: 1;
}

.popup-details h3 {
  font-size: 1.2rem;
  margin: 0 0 8px;
}

.popup-details .price {
  font-weight: bold;
  margin-bottom: 10px;
}

.popup-details .desc {
  font-size: 0.9rem;
  color: #444;
  margin-bottom: 15px;
}

/* Options */
.popup-option {
 
}

.popup-option label {
  font-size: 14px;
  font-weight: 400;
  display: block;
  margin-bottom: 6px;
}

.color-options {
  display: flex;
  gap: 10px;
}

.color-options button {
  padding: 8px 15px;
  border: 1px solid #000;
  cursor: pointer;
  background: #fff;
  width: 100%
}

.color-options button.active {
  background: #000;
  color: #fff;
}

.size-select {
  width: 100%;
  padding: 10px;
  border: 1px solid #aaa;
}

/* Add to Cart */
.add-to-cart-btn {
  margin-top: 20px;
  width: 100%;
  background: #000;
  color: #fff;
  padding: 14px;
  font-size: 1rem;
  cursor: pointer;
  border: none;
}

.add-to-cart-btn:hover {
  background: #333;
}
/* Variant styles */
.variant-options {
  margin: 20px 0;
}

.variant-label {
  font-weight: 600;
  margin-bottom: 8px;
}

.variant-buttons {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.variant-button {
  flex: 1;
  border: 1px solid #000;
  padding: 10px;
  cursor: pointer;
  position: relative;
  background: #fff;
  font-family: 'Jost', sans-serif;
  text-align: center;
}

.variant-button::before {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 6px;
  height: 100%;
}

.variant-button[data-color="Blue"]::before { background: blue; }
.variant-button[data-color="Black"]::before { background: black; }
/* add more color mappings here */

.variant-button.active {
  border: 2px solid #000;
}

select.variant-select {
  width: 100%;
  padding: 10px;
  border: 1px solid #000;
  font-family: 'Jost', sans-serif;
}

.add-to-cart-btn {
  display: block;
  width: 100%;
  margin-top: 20px;
  background: #000;
  color: #fff;
  padding: 14px;
  border: none;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
}

/* Responsive */
@media(max-width: 600px) {
  .popup-product {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .grid-heading {
    font-size: 24px;
    
}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  var plusButtons = document.querySelectorAll(".plus-icon");
  var popup = document.getElementById("productPopup");
  var popupClose = document.getElementById("popupClose");
  var popupBody = document.getElementById("popupBody");

  plusButtons.forEach(function(button) {
    button.addEventListener("click", function() {
      var handle = this.dataset.handle;

      fetch(`/products/${handle}.js`)
        .then(res => res.json())
        .then(product => {
          let colorOptions = '';
          let sizeOptions = '';

          if(product.options.includes("Color")) {
            let colorIndex = product.options.indexOf("Color");
            let colors = [...new Set(product.variants.map(v => v.options[colorIndex]))];
            colorOptions = `
              <div class="variant-options">
                <div class="variant-label">Color</div>
                <div class="variant-buttons">
                  ${colors.map(c => `<div class="variant-button" data-color="${c}" data-value="${c}">${c}</div>`).join("")}
                </div>
              </div>
            `;
          }

          if(product.options.includes("Size")) {
            let sizeIndex = product.options.indexOf("Size");
            let sizes = [...new Set(product.variants.map(v => v.options[sizeIndex]))];
            sizeOptions = `
              <div class="variant-options">
                <div class="variant-label">Size</div>
                <select class="variant-select" id="sizeSelect">
                  <option value="">Choose your size</option>
                  ${sizes.map(s => `<option value="${s}">${s}</option>`).join("")}
                </select>
              </div>
            `;
          }

          let popupHTML = `
            <div class="popup-product">
              <img src="${product.featured_image}" alt="${product.title}" style="max-width:200px; margin-bottom:15px;">
              <h3>${product.title}</h3>
              <div class="price">${(product.price/100).toFixed(2)} ${Shopify.currency.active}</div>
              <div class="desc">${product.description}</div>
              ${colorOptions}
              ${sizeOptions}
              <button class="add-to-cart-btn" data-product-id="${product.id}">ADD TO CART</button>
            </div>
          `;

          popupBody.innerHTML = popupHTML;
          popup.style.display = "block";

          // Color selection
          document.querySelectorAll(".variant-button").forEach(btn => {
            btn.addEventListener("click", function(){
              document.querySelectorAll(".variant-button").forEach(b => b.classList.remove("active"));
              this.classList.add("active");
            });
          });

          // Add to Cart
          document.querySelector(".add-to-cart-btn").addEventListener("click", function(){
            let selectedColor = document.querySelector(".variant-button.active")?.dataset.value;
            let selectedSize = document.getElementById("sizeSelect")?.value;

            let variant = product.variants.find(v => {
              let match = true;
              if(selectedColor) match = match && v.options.includes(selectedColor);
              if(selectedSize) match = match && v.options.includes(selectedSize);
              return match;
            });

            if(variant) {
              fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: variant.id, quantity: 1 })
              }).then(() => {
                alert('Added to cart!');
                popup.style.display = "none";
              });
            } else {
              alert("Please select options");
            }
          });
        });
    });
  });

  popupClose.addEventListener("click", function() {
    popup.style.display = "none";
  });
  window.addEventListener("click", function(e) {
    if (e.target === popup) popup.style.display = "none";
  });
});
</script>
